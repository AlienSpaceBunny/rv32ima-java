<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alienspacebunny</groupId>
        <artifactId>rv32emu-parent</artifactId>
        <version>0.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>rv32emu-cli</artifactId>

    <name>RV32IMA Emulator CLI</name>
    <description>
        Command-line reference runner for rv32emu-core: loads a flat RISC-V binary, wires UART /
        CLINT / SYSCON hooks, and executes. Distributed as a fat jar via GitHub Releases, not Maven.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.alienspacebunny</groupId>
            <artifactId>rv32emu-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.alienspacebunny.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>packaged-cli-smoke-test</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java jar="${project.build.directory}/${project.build.finalName}.jar"
                                      fork="true"
                                      failonerror="true"
                                      output="${project.build.directory}/packaged-cli-smoke.out">
                                    <arg value="-f"/>
                                    <arg file="${project.basedir}/src/test/resources/bin/baremetal.bin"/>
                                    <arg value="-c"/>
                                    <arg value="10000000"/>
                                    <arg value="-p"/>
                                </java>
                                <loadfile property="packaged.cli.output"
                                          srcFile="${project.build.directory}/packaged-cli-smoke.out"/>
                                <condition property="packaged.cli.output.ok">
                                    <contains string="${packaged.cli.output}"
                                              substring="Hello world from RV32 land."/>
                                </condition>
                                <fail unless="packaged.cli.output.ok"
                                      message="Packaged CLI smoke test did not produce expected UART output."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
