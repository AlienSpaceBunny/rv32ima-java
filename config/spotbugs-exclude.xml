<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        Suppressed SpotBugs findings. Each suppression must have a justification comment.
        Prefer fixing real bugs; only suppress confirmed false positives or accepted risks.
    -->

    <!--
        FFMMemoryBus.getSegment() intentionally exposes the underlying MemorySegment as an
        escape hatch for bulk operations (e.g. loading a binary image via copyFrom). The method
        is documented as an advanced-use API. Callers take ownership of aliasing consequences.
    -->
    <Match>
        <Class name="com.alienspacebunny.emu.FFMMemoryBus"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!--
        MMIOBus is a decorator that wraps a MemoryBus. Storing the reference is intentional:
        the backing bus is shared between the MMIOBus and its caller by design (both must see
        the same memory). Making a defensive copy of a MemoryBus would be wrong here.
    -->
    <Match>
        <Class name="com.alienspacebunny.emu.MMIOBus"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
        RV32IMAState is a C-struct-style object that mirrors the mini-rv32ima state layout.
        The cycle/timer half-word fields (cyclel/cycleh, timerl/timerh, timermatchl/timermatchh)
        must be public because CLINTHook reads and writes individual 32-bit MMIO registers at
        distinct addresses — the CLINT memory map exposes each half-word as its own register.
        The 64-bit getter/setter methods are convenience APIs for the emulator core. Both
        access modes are intentional and cannot be collapsed without losing MMIO fidelity.
    -->
    <Match>
        <Class name="com.alienspacebunny.emu.RV32IMAState"/>
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
    </Match>


    <!--
        CLINTHook stores a RV32IMAState reference to read/write timer registers on each MMIO
        access. Sharing the reference is intentional: the state must be the same object that
        the emulator core updates each step. A defensive copy would be both wrong and impossible
        (state has no copy constructor).
    -->
    <Match>
        <Class name="com.alienspacebunny.cli.CLINTHook"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
        MiniRV32IMACSRHook stores a MemoryBus reference to perform string reads on behalf of
        CSR 0x138 (print-string debug CSR). The bus must be the same live object used by the
        emulator. A defensive copy of a MemoryBus is not meaningful.
    -->
    <Match>
        <Class name="com.alienspacebunny.cli.MiniRV32IMACSRHook"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
        RV32IMACore.roundToFloat's RMM (round-to-nearest, ties-away-from-zero) tie check compares
        `approx` against the exact midpoint of two adjacent floats for equality. This is
        intentional, not a precision bug: `approx` is always within half a double-ulp of the true
        mathematical result (see the Phase 5b design note on that method), and a float midpoint is
        always exactly representable in double (float's 24-bit mantissa is far below double's 53),
        so an exact equality check is the correct way to detect a genuine tie; an epsilon
        comparison would be wrong here, not safer.
    -->
    <Match>
        <Class name="com.alienspacebunny.emu.RV32IMACore"/>
        <Method name="roundToFloat"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>

    <!--
        RV32IMACore's constructors throw NullPointerException (via Objects.requireNonNull) before
        any field is assigned. SpotBugs 4.10 flags this as a "finalizer attack" vector: a malicious
        subclass could override finalize() to capture the partially-constructed object. That threat
        model does not apply here — the core holds no privileged or security-sensitive state, a
        core with a null isaConfig is inert, and finalization is deprecated for removal on the
        JDK 25 baseline. The real fix would be making the class final, which is a public-API change
        held for the API-freeze review rather than slipped in under a tooling bump.
    -->
    <Match>
        <Class name="com.alienspacebunny.emu.RV32IMACore"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
        Test classes deliberately pass null to non-null parameters inside assertThrows lambdas
        to verify the documented NullPointerException contract. SpotBugs reports these as
        null-parameter defects; they are the point of the test. The finding lands on the synthetic
        lambda method, so this is scoped by class rather than by test method.
    -->
    <Match>
        <Class name="~com\.alienspacebunny\..*Test"/>
        <Bug pattern="NP_NULL_PARAM_DEREF_NONVIRTUAL,NP_NULL_PARAM_DEREF_ALL_TARGETS_DANGEROUS"/>
    </Match>

</FindBugsFilter>
