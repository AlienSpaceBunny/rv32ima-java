<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.alienspacebunny</groupId>
        <artifactId>rv32emu-parent</artifactId>
        <version>0.1.11-SNAPSHOT</version>
    </parent>

    <artifactId>rv32emu-core</artifactId>

    <name>RV32IMA Emulator Core</name>
    <description>Platform-agnostic RISC-V RV32IMA_Zicsr emulator library: interpreter core, FFM-backed
        off-heap memory bus, MMIO/CSR hook interfaces. No runtime dependencies.</description>
    <url>https://github.com/nkedel/rv32ima-java</url>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Rerun the suite with a decoded instruction cache on every core (see TestCores):
                 4 slots forces conflicts, 4096 is a realistic size. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>decoded-cache-4</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/surefire-reports-dc4</reportsDirectory>
                            <systemPropertyVariables>
                                <rv32emu.test.decodedCacheSlots>4</rv32emu.test.decodedCacheSlots>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>decoded-cache-4096</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/surefire-reports-dc4096</reportsDirectory>
                            <systemPropertyVariables>
                                <rv32emu.test.decodedCacheSlots>4096</rv32emu.test.decodedCacheSlots>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
