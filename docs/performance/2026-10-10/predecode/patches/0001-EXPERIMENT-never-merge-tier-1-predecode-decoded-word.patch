From 04fdf54dfd653c1a5934eb026e9ee0dfbe92a14a Mon Sep 17 00:00:00 2001
From: Nate Edel <nate@natecodes.com>
Date: Sat, 10 Oct 2026 02:11:32 -0700
Subject: [PATCH 1/2] EXPERIMENT (never merge): tier-1 predecode decoded-word
 cache

Opt-in core flag caching each successfully fetched instruction word per
halfword of the executable window, with no invalidation; the bench's
--predecode flag enables it and checks after every invocation that guest
code is unchanged. Upper-bound measurement only, per
docs/PREDECODE_EXPERIMENT_PLAN.md. Correctness-smoked at test scale on
bytearray and router (all 14 workloads verified); not yet measured.
---
 bench/run_matrix.py                           |   9 ++
 .../com/alienspacebunny/bench/Harness.java    |   4 +-
 .../com/alienspacebunny/bench/Workloads.java  |  31 ++++-
 .../com/alienspacebunny/emu/RV32IMACore.java  | 118 ++++++++++++------
 4 files changed, 124 insertions(+), 38 deletions(-)

diff --git a/bench/run_matrix.py b/bench/run_matrix.py
index 3931c54..9d083df 100755
--- a/bench/run_matrix.py
+++ b/bench/run_matrix.py
@@ -54,6 +54,13 @@ def cells(args):
