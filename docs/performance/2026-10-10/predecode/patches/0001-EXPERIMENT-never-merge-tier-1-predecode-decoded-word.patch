--- a/core/src/main/java/com/alienspacebunny/emu/RV32IMACore.java
+++ b/core/src/main/java/com/alienspacebunny/emu/RV32IMACore.java
@@ -59,7 +59,42 @@ public class RV32IMACore {
      * @throws NullPointerException if {@code isaConfig} is {@code null}.
      */
     public RV32IMACore(IsaConfig isaConfig) {
+        this(isaConfig, false);
+    }
+
+    /**
+     * EXPERIMENT ONLY (branch {@code exp/predecode}; never merged). With {@code
+     * experimentalPredecode}, successfully fetched instruction words are cached per halfword of
+     * the executable window and reused without a bus fetch. There is no invalidation: valid only
+     * for guest code that is never modified. See {@code docs/PREDECODE_EXPERIMENT_PLAN.md}.
+     *
+     * @param isaConfig the extension configuration.
+     * @param experimentalPredecode whether to cache fetched instruction words.
+     */
+    public RV32IMACore(IsaConfig isaConfig, boolean experimentalPredecode) {
         this.isaConfig = Objects.requireNonNull(isaConfig, "isaConfig");
+        this.predecode = experimentalPredecode;
+    }
+
+    // ---- EXPERIMENT: tier-1 decoded-word cache ------------------------------------------------
+    //
+    // One int per halfword of [cacheOffset, cacheOffset + cacheSize). Every cached word is a
+    // standard 32-bit encoding (bits 1:0 == 0b11), so those bits carry a tag instead: 0 = empty,
+    // 1 = compressed (instrLen 2), 2 = 32-bit (instrLen 4); the word is entry | 3. Only
+    // successful fetches of encodings with bits 1:0 == 0b11 are cached, so faults and reserved
+    // compressed patterns always take the normal path.
+    private final boolean predecode;
+    private int[] decodedWords;
+    private int cacheOffset;
+    private int cacheSize;
+
+    private int[] decodedWordsFor(int ramOffset, int ramSize) {
+        if (decodedWords == null || cacheOffset != ramOffset || cacheSize != ramSize) {
+            decodedWords = new int[(int) ((Integer.toUnsignedLong(ramSize) + 1) >>> 1)];
+            cacheOffset = ramOffset;
+            cacheSize = ramSize;
+        }
+        return decodedWords;
     }
 
     private static final int MSTATUS_MIE = 0x08;
@@ -1485,6 +1520,8 @@ public class RV32IMACore {
             state.extraflags &= ~EXTRAFLAG_WFI;
         }
 
+        int[] wordCache = predecode ? decodedWordsFor(ramOffset, ramSize) : null;
+
         // Set by an instruction that can change interrupt deliverability (a write to mstatus,
         // mie, or mip, or MRET); checked once that instruction has fully retired so a newly
         // deliverable interrupt is taken before the next guest instruction in this batch runs.
@@ -1512,44 +1549,55 @@ public class RV32IMACore {
                     rval = pc;
                     break;
