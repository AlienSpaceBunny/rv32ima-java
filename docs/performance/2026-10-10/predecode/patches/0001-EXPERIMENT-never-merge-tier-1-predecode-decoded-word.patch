-                                AccessContext fetchCtx32 =
-                                        new AccessContext(state.hartId, privilege, AccessKind.FETCH, 4, 0);
-                                ir = mem.readInt(pc, fetchCtx32);
+                    int cacheSlot = ofsPc >>> 1;
+                    int cached = wordCache != null ? wordCache[cacheSlot] : 0;
+                    if (cached != 0) {
+                        ir = cached | 0x3;
