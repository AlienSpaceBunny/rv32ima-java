+    private AttemptResult runAttemptsCached(
+            RV32IMAState state,
+            MemoryBus mem,
+            int ramOffset,
+            int ramSize,
+            int budget,
+            CSRHook csrHook,
+            AttemptController controller) {
+        int attempts = 0;
+        while (true) {
+            if (controller != null) {
+                controller.beforeAttempt(state);
+            }
+            if (attempts == 0) {
+                sampleTime(state);
+            } else {
+                updateTimerPending(state);
+            }
+            attempts++;
+            int interrupt = pendingInterruptTrap(state);
+            int result = 0;
+            if ((state.extraflags & EXTRAFLAG_WFI) != 0 && wakeInterrupts(state) == 0) {
+                result = 1;
+            } else {
+                state.extraflags &= ~EXTRAFLAG_WFI;
+                if (interrupt != 0) {
+                    state.pc = commitTrap(state, state.pc - 4, interrupt, 0, 0, 4);
+                } else {
+                    result = runCached(state, mem, ramOffset, ramSize, 1, null, csrHook);
+                    if (dcFenceI) {
+                        dcFenceI = false;
+                        flushDecodedCache();
+                        result = 0;
+                    }
+                }
+            }
+            boolean stopped = controller != null && controller.afterAttempt(state, result);
+            if (stopped || result != 0 || attempts == budget) {
+                return new AttemptResult(result, attempts, stopped);
+            }
+        }
+    }
