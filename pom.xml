<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.alienspacebunny</groupId>
        <artifactId>alienspacebunny-parent</artifactId>
        <version>0.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.alienspacebunny</groupId>
    <artifactId>rv32emu-parent</artifactId>
    <version>0.1.6-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RV32IMA Emulator (parent)</name>
    <description>Platform-agnostic RISC-V RV32IMA emulator for Java 25 — a port of cnlohr's mini-rv32ima.
        Multi-module build: rv32emu-core (the library) and rv32emu-cli (a reference runner).</description>
    <url>https://github.com/AlienSpaceBunny/rv32ima-java</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Nate Edel</name>
            <email>nate.edel@gmail.com</email>
            <url>https://github.com/nkedel</url>
        </developer>
    </developers>

    <modules>
        <module>core</module>
        <module>cli</module>
    </modules>

    <scm>
        <connection>scm:git:https://github.com/AlienSpaceBunny/rv32ima-java.git</connection>
        <developerConnection>scm:git:git@github.com:AlienSpaceBunny/rv32ima-java.git</developerConnection>
        <url>https://github.com/AlienSpaceBunny/rv32ima-java</url>
    </scm>

    <properties>
        <!-- rv32emu's own Checkstyle rules (smaller than the shared set); see alienspacebunny-parent. -->
        <asb.checkstyle.config>${asb.config.dir}/checkstyle.xml</asb.checkstyle.config>
        <!-- The manual release workflow passes -Dasb.release.push=true; local releases never push. -->
        <asb.release.push>false</asb.release.push>
    </properties>

    <build>
        <!-- Maven Central (-Pcentral-release, profile inherited from alienspacebunny-parent):
             only rv32emu-core and this parent POM are published; the CLI fat jar goes to a
             GitHub Release instead (RELEASE_TODO.md). -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <configuration>
                        <excludeArtifacts>
                            <excludeArtifact>rv32emu-cli</excludeArtifact>
                        </excludeArtifacts>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- Shared gates (Spotless, Checkstyle, SpotBugs, enforcer) and all plugin pins
             come from alienspacebunny-parent. -->
        <plugins>
            <!-- Unlike the shared default, SpotBugs also analyzes test classes here. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <includeTests>true</includeTests>
                </configuration>
            </plugin>
            <!--
                maven-javadoc-plugin: generates Javadoc HTML and packages it as a -javadoc.jar.
                failOnError=true ensures CI fails if public API Javadoc has errors or warnings.
                Required for Maven Central publication alongside the source jar below.
                Run `mvn javadoc:aggregate` to generate combined multi-module Javadoc locally.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <failOnError>true</failOnError>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                maven-source-plugin: packages source files as a -sources.jar.
                Required for Maven Central publication.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                maven-release-plugin: versions, tags, and builds a release from a git tag.
                See docs/RELEASING.md for the step-by-step local release procedure.

                `perform` runs `install`, not the default `deploy`: a local release only installs
                the tagged build. Publishing to Maven Central is the manual GitHub release
                workflow's job (-Pcentral-release deploy), and is on hold (RELEASE_TODO.md).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <!-- All 3 poms share one version; don't prompt separately per module. -->
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- Commit + tag locally only; pushing is a separate, explicit step.
                         Only the manual GitHub release workflow sets asb.release.push=true. -->
                    <pushChanges>${asb.release.push}</pushChanges>
                    <!-- perform builds from the local tag; it need not be pushed to origin first. -->
                    <localCheckout>true</localCheckout>
                    <!-- The release POM rewrite changes XML layout (e.g. <x/> becomes <x />);
                         re-format before Spotless checks it and before each release commit. -->
                    <preparationGoals>clean spotless:apply verify</preparationGoals>
                    <completionGoals>spotless:apply</completionGoals>
                    <goals>install</goals>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
