<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.alienspacebunny</groupId>
    <artifactId>rv32emu-parent</artifactId>
    <version>0.1.6-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RV32IMA Emulator (parent)</name>
    <description>Platform-agnostic RISC-V RV32IMA emulator for Java 25 — a port of cnlohr's mini-rv32ima.
        Multi-module build: rv32emu-core (the library) and rv32emu-cli (a reference runner).</description>
    <url>https://github.com/nkedel/rv32ima-java</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Nate Edel</name>
            <email>nate.edel@gmail.com</email>
            <url>https://github.com/nkedel</url>
        </developer>
    </developers>

    <modules>
        <module>core</module>
        <module>cli</module>
    </modules>

    <scm>
        <connection>scm:git:https://github.com/nkedel/rv32ima-java.git</connection>
        <developerConnection>scm:git:git@github.com:nkedel/rv32ima-java.git</developerConnection>
        <url>https://github.com/nkedel/rv32ima-java</url>
    </scm>

    <properties>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
        <junit.version>6.1.3</junit.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <palantir.java.format.version>2.90.0</palantir.java.format.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <release.plugin.version>3.3.1</release.plugin.version>
        <source.plugin.version>3.4.0</source.plugin.version>
        <spotbugs.plugin.version>4.10.4.1</spotbugs.plugin.version>
        <spotless.version>3.10.2</spotless.version>
        <surefire.plugin.version>3.5.4</surefire.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                JUnit BOM: single source of truth for all JUnit Platform, Jupiter, and
                Vintage artifact versions (unified versioning since JUnit 6). Module poms
                declare the individual artifacts without a <version>.
            -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- Pin lifecycle defaults as well as explicitly invoked plugins.
         Stable Maven Central releases checked 2026-09-16; no Maven 4 previews. -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.8.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-help-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-wrapper-plugin</artifactId>
                    <version>3.3.4</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.4</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.22.0</version>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>1.1.13</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-requirements</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.16,4)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Surefire is pinned explicitly: the Maven-bundled default lags the JUnit
                Platform release train, and the Platform artifacts jumped to 6.x under
                unified versioning. A recent Surefire ensures correct test-engine discovery.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <!--
                Spotless enforces Palantir Java Format (4-space indent, IntelliJ-compatible style).
                Run `mvn spotless:apply` to auto-format. `mvn verify` fails if formatting is dirty.

                Wildcard imports (import foo.*) are not banned here; they will be rejected by
                Checkstyle's AvoidStarImport rule when Checkstyle is configured (next step).

                CI note: GitHub Actions should run `mvn verify`, which triggers spotless:check
                at the verify phase and fails the build if any file needs reformatting.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir.java.format.version}</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                    </java>
                    <!-- Add this block to target and format your Maven files -->
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                            <include>**/pom.xml</include>
                            <!-- Targets sub-modules in multi-module projects -->
                        </includes>
                        <sortPom>
                            <encoding>UTF-8</encoding>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <keepBlankLines>true</keepBlankLines>
                            <indentBlankLines>false</indentBlankLines>
                            <indentSchemaLocation>true</indentSchemaLocation>
                            <expandEmptyElements>false</expandEmptyElements>
                            <sortProperties>true</sortProperties>
                            <!-- Optional: sorts dependencies by scope, groupId, artifactId -->
                            <sortDependencies>scope,groupId,artifactId</sortDependencies>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!--
            Checkstyle enforces import and correctness rules that Spotless does not cover.
            Key rule: AvoidStarImport bans wildcard imports (import foo.*).
            Config: config/checkstyle.xml in the project root.
            CI note: `mvn verify` runs both Spotless and Checkstyle.
        -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Default</threshold>
                    <includeTests>true</includeTests>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!--
                maven-javadoc-plugin: generates Javadoc HTML and packages it as a -javadoc.jar.
                failOnError=true ensures CI fails if public API Javadoc has errors or warnings.
                Required for Maven Central publication alongside the source jar below.
                Run `mvn javadoc:aggregate` to generate combined multi-module Javadoc locally.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${javadoc.plugin.version}</version>
                <configuration>
                    <failOnError>true</failOnError>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                maven-source-plugin: packages source files as a -sources.jar.
                Required for Maven Central publication.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                maven-release-plugin: versions, tags, and builds a release from a git tag.
                See docs/RELEASING.md for the step-by-step local release procedure.

                `perform` currently runs `install`, not the default `deploy`: there is no
                Maven Central deploy wired yet (RELEASE_TODO.md R1-R4 are deliberately on
                hold). Change `goals` to `deploy` (or a dedicated release profile) once that
                lands; until then this only installs the tagged build to the local repository.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${release.plugin.version}</version>
                <configuration>
                    <!-- All 3 poms share one version; don't prompt separately per module. -->
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- Commit + tag locally only; pushing is a separate, explicit step. -->
                    <pushChanges>false</pushChanges>
                    <!-- perform builds from the local tag; it need not be pushed to origin first. -->
                    <localCheckout>true</localCheckout>
                    <goals>install</goals>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <configuration>
                    <ignoredVersions>(?i).*-(alpha|beta|m|rc)[-.\d]*</ignoredVersions>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
